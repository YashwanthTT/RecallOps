# Groq LLM (optional). Without it the app uses its deterministic offline writer.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Optional override; defaults to https://api.groq.com/openai/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Hindsight. Defaults work for the local Docker container.
HINDSIGHT_BASE_URL=http://localhost:8888
# Required for Hindsight Cloud, blank for local.
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incident-response-agent
# `reflect` is agentic and can take a minute on Cloud. Raise for slow networks.
HINDSIGHT_TIMEOUT=120
